{
  "name": "npm-package-navigator",
  "displayName": "NPM Package Navigator",
  "description": "Navigate quickly to npm package resources directly from JavaScript and TypeScript projects.",
  "version": "0.1.5",
  "publisher": "jymeng",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeremymeng/npm-package-navigator.git"
  },
  "engines": {
    "vscode": "^1.83.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "npm",
    "packages",
    "navigation",
    "javascript",
    "typescript"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:json",
    "onLanguage:yaml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "npm-package-navigator.showPackageMenu",
        "title": "Package Navigator: Open Menu"
      },
      {
        "command": "npm-package-navigator.openPackageDirectory",
        "title": "Package Navigator: Open Package Directory"
      },
      {
        "command": "npm-package-navigator.openPackageJson",
        "title": "Package Navigator: Open package.json"
      },
      {
        "command": "npm-package-navigator.openReadme",
        "title": "Package Navigator: Open README"
      },
      {
        "command": "npm-package-navigator.openRepository",
        "title": "Package Navigator: Open Repository"
      },
      {
        "command": "npm-package-navigator.openHomepage",
        "title": "Package Navigator: Open Homepage"
      },
      {
        "command": "npm-package-navigator.openIssues",
        "title": "Package Navigator: Open Issues"
      },
      {
        "command": "npm-package-navigator.openNpm",
        "title": "Package Navigator: Open npmjs"
      },
      {
        "command": "npm-package-navigator.openUnpkg",
        "title": "Package Navigator: Open on unpkg.com"
      },
      {
        "command": "npm-package-navigator.openJsDelivr",
        "title": "Package Navigator: Open on jsDelivr"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "npm-package-navigator.showPackageMenu",
          "group": "navigation@1",
          "when": "editorTextFocus && (resourceExtname == .js || resourceExtname == .jsx || resourceExtname == .ts || resourceExtname == .tsx || resourceExtname == .mjs || resourceExtname == .cjs || resourceExtname == .json || resourceExtname == .yaml || resourceExtname == .yml)"
        }
      ]
    },
    "configuration": {
      "title": "NPM Package Navigator",
      "properties": {
        "npmPackageNavigator.debugLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose debug logging in the Output panel."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && tsc -p ./test",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md}\"",
    "test": "node ./out/test/test/runTest.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.5.0",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/vscode": "^1.83.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-electron": "^2.3.0",
    "eslint": "^9.5.0",
    "glob": "^11.0.3",
    "globals": "^15.3.0",
    "mocha": "^11.7.2",
    "prettier": "^3.3.3",
    "typescript": "^5.2.2"
  }
}
